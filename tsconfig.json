{
  "include": [
    "app",
    "app/types",
    "index.tsx",
    "index.ts",
    "App.tsx"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "app/*"
      ],
      "@features/*": [
        "app/features/*"
      ],
      "@shared/*": [
        "app/shared/*"
      ],
      "@navigation/*": [
        "app/navigation/*"
      ],
      "@constants/*": [
        "app/shared/constants/*"
      ]
    },
    "jsx": "react",
    "moduleResolution": "bundler",
    "target": "esnext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "esnext"
  },
  "extends": "expo/tsconfig.base"
}
