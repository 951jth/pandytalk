{
  "name": "cshchatapp",
  "version": "1.4.4",
  "private": true,
  "main": "index.tsx",
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-reanimated"
      ]
    }
  },
  "scripts": {
    "android": "react-native run-android --mode developmentDebug --appId com.cshchatapp.debug",
    "android:custom": "react-native run-android --deviceId emulator-5554",
    "ios": "expo run:ios",
    "start": "react-native start",
    "lint": "eslint \"app/**/*.{js,jsx,ts,tsx}\"",
    "test": "jest --runInBand",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.tsx --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res --reset-cache",
    "release-android": "cd android && gradlew assembleRelease && cd ..",
    "clean-android": "cd android && gradlew clean && cd ..",
    "build:aab": "npm run prebuild && cd android && gradlew bundleProductionRelease && cd ..",
    "submit:aab": "eas submit --platform android --path ./android/app/build/outputs/bundle/productionRelease/app-production-release.aab",
    "build:submit": "npm run build:aab && npm run submit:aab",
    "update": "eas update --branch main",
    "eas:build": "eas build --platform android --profile production",
    "prebuild": "npx expo prebuild --no-install",
    "eas-build-pre-install": "cp $GOOGLE_SERVICES_JSON ./android/app/google-services.json",
    "typecheck": "tsc --noEmit",
    "verify": "yarn lint --quiet && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/analytics": "22.2.1",
    "@react-native-firebase/app": "22.2.1",
    "@react-native-firebase/auth": "22.2.1",
    "@react-native-firebase/crashlytics": "22.2.1",
    "@react-native-firebase/firestore": "22.2.1",
    "@react-native-firebase/messaging": "22.2.1",
    "@react-native-firebase/remote-config": "22.2.1",
    "@react-native-firebase/storage": "22.2.1",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.2",
    "@react-navigation/native-stack": "^7.3.13",
    "@reduxjs/toolkit": "^2.8.2",
    "@shopify/flash-list": "1.8.3",
    "@tanstack/react-query": "^5.77.2",
    "base-64": "^1.0.0",
    "dayjs": "^1.11.13",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-updates": "~29.0.19",
    "firebase-admin": "^13.4.0",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.23.2",
    "react-native-bootsplash": "^6.3.11",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-paper": "^5.14.1",
    "react-native-permissions": "^5.4.1",
    "react-native-reanimated": "~3.19.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-sse": "^1.2.1",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.17",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^3.5.3",
    "react-native-asset": "^2.1.1",
    "react-native-make": "^1.0.1",
    "react-refresh": "^0.14.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
