{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleDevelopmentDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      }
    },
    "production": {
      "channel": "main",
      "android": {
        "gradleCommand": ":app:bundleProductionRelease"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      },
      "channel": "main"
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.cshchatapp",
        "track": "production"
      }
    }
  }
}
